#!/usr/bin/env bash
# Apply one textual mutation, run the workspace suite, report a verdict.
#
# THE WORKING TREE IS NEVER TOUCHED. The mutation happens in a scratch copy
# extracted from a git ref, so this is safe to run while someone else is
# editing — and the verdict is pinned to a commit, which makes it reproducible
# by anyone with that SHA rather than a photograph of one desk at one moment.
# The earlier version of this script mutated in place and restored via `trap`;
# that is correct only while nobody else is working, which is not a condition
# a script can check.
#
# Refuses to report a verdict unless the anchor matched exactly once and the
# tree compiled. Three ways a mutation run lies, all producing the same clean
# output as a genuinely surviving mutant, all hit for real here:
#
#   1. the anchor matched zero places, or several — nothing was mutated;
#   2. the mutant did not compile — nothing was run;
#   3. you grepped `^error` to catch (2), but `cargo test` prints
#      `error: test failed` on every SUCCESSFUL kill, so the check fires
#      exactly when the mutation worked.
#
# For an exhaustive run rather than a chosen one, use `cargo mutants` — it
# finds 187 mutants in memorysafe-backend-sqlite, at roughly six seconds each.
# This script is for testing a specific hypothesis; that one is for the
# denominator.
#
# Usage:  scripts/mutate <repo-relative-file> <anchor> <replacement> [label]
# Env:    MUTATE_REF (default HEAD) — the commit to mutate a copy of.
set -uo pipefail
FILE="$1"; ANCHOR="$2"; REPLACEMENT="$3"; LABEL="${4:-$ANCHOR}"

REF="${MUTATE_REF:-HEAD}"
SHA=$(git rev-parse --short "$REF") || { echo "no such ref: $REF" >&2; exit 1; }
git cat-file -e "$REF:$FILE" 2>/dev/null || { echo "not in $SHA: $FILE" >&2; exit 1; }

WORK="${TMPDIR:-/tmp}/mutate-$SHA"
if [ ! -f "$WORK/.extracted" ]; then
    rm -rf "$WORK"; mkdir -p "$WORK"
    git archive "$REF" | tar -x -C "$WORK" || { echo "archive failed" >&2; exit 1; }
    touch "$WORK/.extracted"
    echo "  [extracted $SHA to $WORK — target/ is reused across runs]"
fi

restore() { git show "$REF:$FILE" > "$WORK/$FILE"; }
trap restore EXIT
restore

python3 - "$WORK/$FILE" "$ANCHOR" "$REPLACEMENT" <<'PY' || exit 3
import pathlib, sys
p = pathlib.Path(sys.argv[1]); s = p.read_text()
n = s.count(sys.argv[2])
if n != 1:
    print(f"  ANCHOR MATCHED {n} PLACES — mutation NOT applied, no verdict")
    sys.exit(3)
p.write_text(s.replace(sys.argv[2], sys.argv[3]))
PY

OUT=$(cd "$WORK" && cargo test --workspace --offline 2>&1)
if echo "$OUT" | grep -qE 'error\[E|could not compile'; then
    echo "  $LABEL: DID NOT COMPILE — no verdict"
    echo "$OUT" | grep -E 'error\[E|could not compile' | head -3 | sed 's/^/      /'
    exit 4
fi
read -r PASSED FAILED <<<"$(echo "$OUT" | awk '/^test result/{p+=$4; f+=$6} END{print p, f}')"
if [ "${FAILED:-0}" -gt 0 ]; then
    echo "  $LABEL: KILLED ($FAILED failed, $PASSED passed) @ $SHA"
    echo "$OUT" | grep -E '^test .* FAILED|panicked at' | head -4 | sed 's/^/      /'
else
    echo "  $LABEL: SURVIVED ($PASSED passed) @ $SHA — equivalent mutant, or a real gap. Say which."
fi
